---
import NewsDetail from "../../components/templates/NewsDetail.astro";

const date = "2025-11-17";
const title = "Du lịch hè Đà Nẵng";
const image = "/images/news/du-lich-he-a-nang/01.jpg";
---

<NewsDetail date={date} title={title} image={image}>
  <section>
    <p>
      Hình ảnh từ hoạt động <strong>Du lịch hè Đà Nẵng</strong> tại Công ty Bình Phát vào ngày 17/11/2025.
    </p>
  </section>

  <figure>
    <img
      src="/images/news/du-lich-he-a-nang/01.jpg"
      alt="Du lịch hè Đà Nẵng"
      class="w-full h-auto rounded-lg shadow-md"
    />
    <figcaption>
      Du lịch hè Đà Nẵng
    </figcaption>
  </figure>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-8">
    <figure>
      <img
        src="/images/news/du-lich-he-a-nang/02.jpg"
        alt="Du lịch hè Đà Nẵng"
        class="w-full h-auto rounded-lg shadow-md"
      />
    </figure>
    <figure>
      <img
        src="/images/news/du-lich-he-a-nang/03.jpg"
        alt="Du lịch hè Đà Nẵng"
        class="w-full h-auto rounded-lg shadow-md"
      />
    </figure>
    <figure>

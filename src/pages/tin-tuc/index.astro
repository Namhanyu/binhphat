---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/organisms/news/Hero.astro";
import { vi as projects } from "../../components/organisms/projects/ProjectList.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const newsItems = Array.from({ length: 10 }, (_, i) => ({
  id: i + 1,
  title: `Khởi công ${projects[i].name}`,
  date: new Date(
    Date.now() - Math.floor(Math.random() * (5 * 365 * 24 * 60 * 60 * 1000))
  ),
  image: projects[i].images[0].src,
})).sort((a, b) => (b.date as any) - (a.date as any));
---

<Layout title="Bình Phát - Tin tức" snap={false}>
  <Hero />

  <div class="container">
    <h2
      class="hidden md:block text-3xl font-extrabold uppercase max-md:text-xl whitespace-pre-line mt-10"
    >
      {t("news.title")}
    </h2>
    <div class="mb-10 grid md:grid-cols-2 gap-6 max-sm:mt-10">
      {
        newsItems.map((item) => (
          <a
            class="sm:mt-10 group md:[&:nth-child(even)]:-mt-4"
            href={`/tin-tuc/binh-phat-khai-giang-khoa-hoc-vu-tri-tu-nhan-tao`}
          >
            <div class="overflow-hidden aspect-[570/336] flex">
              <img
                src={item.image}
                alt={item.title}
                class="w-full object-cover group-hover:scale-110 transition-transform duration-300"
              />
            </div>
            <div class="px-4 sm:px-8 py-4 flex items-center gap-5 bg-sky-100 group-hover:bg-primary transition-colors duration-300 w-full sm:w-4/5 max-sm:max-w-[400px] -mt-8 z-10 relative sm:rounded-tr-[50px]">
              <div class="text-center text-primary group-hover:text-white transition-colors duration-300 shrink-0">
                <div class="text-[11px] leading-none">
                  {`${item.date.toISOString().split("-")[1]}-${item.date.toISOString().split("-")[0]}`}
                </div>
                <div class="text-[35px] leading-none font-bold">
                  {item.date.toISOString().split("T")[0].split("-")[2]}
                </div>
              </div>
              <div class="w-px h-10 bg-neutral-300" />
              <div class="text-base font-semibold line-clamp-2 uppercase text-black group-hover:text-white transition-colors duration-300">
                {item.title}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

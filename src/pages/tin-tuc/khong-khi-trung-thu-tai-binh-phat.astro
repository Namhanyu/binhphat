        alt="Không khí trung thu tại Bình Phát"
        class="w-full h-auto rounded-lg shadow-md"
      />
    </figure>
    <figure>
      <img
        src="/images/news/khong-khi-trung-thu-tai-binh-phat/10.jpg"
        alt="Không khí trung thu tại Bình Phát"
        class="w-full h-auto rounded-lg shadow-md"
      />
    </figure>
    <figure>
      <img
        src="/images/news/khong-khi-trung-thu-tai-binh-phat/11.jpg"
        alt="Không khí trung thu tại Bình Phát"
        class="w-full h-auto rounded-lg shadow-md"
      />
    </figure>
    <figure>
      <img
        src="/images/news/khong-khi-trung-thu-tai-binh-phat/09.jpg"
        alt="Không khí trung thu tại Bình Phát"
        class="w-full h-auto rounded-lg shadow-md"
      />
    </figure>
    <figure>
      <img
        src="/images/news/khong-khi-trung-thu-tai-binh-phat/07.jpg"
        alt="Không khí trung thu tại Bình Phát"
        class="w-full h-auto rounded-lg shadow-md"
      />
    </figure>
  </div>
</NewsDetail>

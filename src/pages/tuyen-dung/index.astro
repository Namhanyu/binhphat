---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/organisms/recruitment/Hero.astro";
import JobCard from "../../components/organisms/recruitment/JobCard.astro";
import image01 from "../../assets/images/recruit-01.webp";
import image02 from "../../assets/images/recruit-02.webp";
import image03 from "../../assets/images/recruit-03.webp";
import image04 from "../../assets/images/recruit-04.webp";

const jobs = [
  {
    title: "Kỹ sư Cơ điện (Giám sát)",
    slug: "ky-su-co-dien-giam-sat",
    employmentType: "TOÀN THỜI GIAN",
    salary: "18–25 triệu (thỏa thuận theo năng lực)",
    location: "Hà Nội",
    tags: ["Cơ điện", "Kỹ sư", "Giám sát"],
    imageUrl: image01.src,
    isNew: true,
  },
  {
    title: "Kỹ sư công trình",
    slug: "ky-su-cong-trinh",
    employmentType: "TOÀN THỜI GIAN",
    salary: "18-25 triệu (thỏa thuận theo năng lực)",
    location: "Hà Nội",
    tags: ["Xây dựng", "Kỹ sư"],
    imageUrl: image02.src,
    isNew: true,
  },
  {
    title: "Kỹ sư kết cấu",
    slug: "ky-su-ket-cau",
    employmentType: "TOÀN THỜI GIAN",
    salary: "17–25 triệu (thỏa thuận theo năng lực)",
    location: "Hà Nội",
    tags: ["Xây dựng", "Kỹ sư"],
    imageUrl: image03.src,
    isNew: false,
  },
  {
    title: "Kỹ sư thiết kế Cơ điện",
    slug: "ky-su-thiet-ke-co-dien",
    employmentType: "TOÀN THỜI GIAN",
    salary: "14-18 triệu (thỏa thuận theo năng lực)",
    location: "Hà Nội",
    tags: ["Cơ điện", "Kỹ sư", "Thiết kế"],
    imageUrl: image04.src,
    isNew: true,
  },
  {
    title: "Kỹ sư xây dựng",
    slug: "ky-su-xay-dung",
    employmentType: "TOÀN THỜI GIAN",
    salary: "16-20 triệu (thỏa thuận theo năng lực)",
    location: "Hà Nội",
    tags: ["Xây dựng", "Kỹ sư"],
    imageUrl: image01.src,
    isNew: true,
  },
];
---

<Layout title="Bình Phát - Tuyển dụng" snap={false}>
  <Hero />

  <div class="space-y-4 container">
    <div class="space-y-8 my-10">
      {
        jobs.map((job) => (
          <a href={`/tuyen-dung/${job.slug}`} class="flex flex-col gap-6">
            <JobCard {...job} />
          </a>
        ))
      }
    </div>
  </div>
</Layout>

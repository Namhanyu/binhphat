---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/organisms/recruitment/Hero.astro";
import JobCard from "../../components/organisms/recruitment/JobCard.astro";

const jobs = [
  {
    title: "Giám sát Xây dựng",
    slug: "giam-sat-xay-dung",
    employmentType: "TOÀN THỜI GIAN",
    salary: "Ký sự",
    location: "Hà Nội, Hồ Chí Minh, Đà Nẵng, Long An, ... Lương thỏa thuận",
    tags: ["Xây dựng"],
    imageUrl:
      "https://hris.newtecons.vn/api/api/Base/GetFile?filePath=Attachments/screenshot_1682644823_20230428082043388.png",
    isNew: true,
  },
  {
    title: "Thư ký Công trình",
    slug: "thu-ky-cong-trinh",
    employmentType: "TOÀN THỜI GIAN",
    salary: "Lương thỏa thuận",
    location: "Hà Nội",
    tags: ["Kinh tế", "Kinh tế Xây dựng", "Quản trị", "Hành chính"],
    imageUrl:
      "https://hris.newtecons.vn/api/api/Base/GetFile?filePath=Attachments/business-people-working-laptop-development_1262-18907_20231030105131596.jpg",
    isNew: true,
  },
  {
    title: "Kỹ sư Xây dựng Dân dụng",
    slug: "ky-su-xay-dung-dan-dung",
    employmentType: "TOÀN THỜI GIAN",
    salary: "15-25 triệu VNĐ",
    location: "Hồ Chí Minh, Bình Dương",
    tags: ["Xây dựng", "Kỹ thuật"],
    imageUrl:
      "https://hris.newtecons.vn/api/api/Base/GetFile?filePath=Attachments/screenshot_1682645209_20230428082803039.png",
    isNew: false,
  },
  {
    title: "Trưởng phòng Kỹ thuật",
    slug: "truong-phong-ky-thuat",
    employmentType: "TOÀN THỜI GIAN",
    salary: "Lương thỏa thuận",
    location: "Hà Nội, Hải Phòng",
    tags: ["Quản lý", "Xây dựng", "Kỹ thuật"],
    imageUrl:
      "https://hris.newtecons.vn/api/api/Base/GetFile?filePath=Attachments/imager_104534_20220509071857163.jpg",
    isNew: true,
  },
];
---

<Layout title="Bình Phát - Tuyển dụng" snap={false}>
  <Hero />

  <div class="space-y-4 container">
    <div class="space-y-8 my-10">
      {
        jobs.map((job) => (
          <a href={`/tuyen-dung/${job.slug}`} class="flex flex-col gap-6">
            <JobCard {...job} />
          </a>
        ))
      }
    </div>
  </div>
</Layout>

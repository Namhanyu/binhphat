export function getStaticPaths() {
  const jobs = [
    {
      title: "Giám sát Xây dựng",
      slug: "giam-sat-xay-dung",
      employmentType: "TOÀN THỜI GIAN",
      salary: "Ký sự",
      location: "Hà Nội, Hồ Chí Minh, Đà Nẵng, Long An, ... Lương thỏa thuận",
      tags: ["Xây dựng"],
      imageUrl:
        "https://hris.newtecons.vn/api/api/Base/GetFile?filePath=Attachments/screenshot_1682644823_20230428082043388.png",
      isNew: true,
    },
    {
      title: "Thư ký Công trình",
      slug: "thu-ky-cong-trinh",
      employmentType: "TOÀN THỜI GIAN",
      salary: "Lương thỏa thuận",
      location: "Hà Nội",
      tags: ["Kinh tế", "Kinh tế Xây dựng", "Quản trị", "Hành chính"],
      imageUrl:
        "https://hris.newtecons.vn/api/api/Base/GetFile?filePath=Attachments/business-people-working-laptop-development_1262-18907_20231030105131596.jpg",
      isNew: true,
    },
    {
      title: "Kỹ sư Xây dựng Dân dụng",
      slug: "ky-su-xay-dung-dan-dung",
      employmentType: "TOÀN THỜI GIAN",
      salary: "15-25 triệu VNĐ",
      location: "Hồ Chí Minh, Bình Dương",
      tags: ["Xây dựng", "Kỹ thuật"],
      imageUrl:
        "https://hris.newtecons.vn/api/api/Base/GetFile?filePath=Attachments/screenshot_1682645209_20230428082803039.png",
      isNew: false,
    },
    {
      title: "Trưởng phòng Kỹ thuật",
      slug: "truong-phong-ky-thuat",
      employmentType: "TOÀN THỜI GIAN",
      salary: "Lương thỏa thuận",
      location: "Hà Nội, Hải Phòng",
      tags: ["Quản lý", "Xây dựng", "Kỹ thuật"],
      imageUrl:
        "https://hris.newtecons.vn/api/api/Base/GetFile?filePath=Attachments/imager_104534_20220509071857163.jpg",
      isNew: true,
    },
  ];
  return jobs.map((job) => ({ params: { id: job.slug } }));
}

const { id } = Astro.params;
---

<Layout title="Bình Phát - Chi tiết tuyển dụng" snap={false}>
  <Hero />

  <div class="min-h-screen bg-background">
    <div class="container mx-auto px-4 py-8 lg:py-12">
      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-8">
          <!-- Header -->
          <div class="space-y-4">
            <h1 class="text-4xl lg:text-5xl font-bold text-balance">
              Giám sát Xây dựng
            </h1>
            <div class="flex flex-wrap items-center gap-3">
              <span
                class="bg-primary text-primary-foreground px-4 py-1.5 text-sm font-medium rounded-md"
              >
                TOÀN THỜI GIAN
              </span>
              <div class="flex items-center gap-2 text-muted-foreground">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
                  ></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span class="text-sm"
                  >Hà Nội, Hồ Chí Minh, Đà Nẵng, Long An, ... Lương thỏa thuận</span
                >
              </div>
            </div>
            <button
              class="bg-primary text-primary-foreground px-6 py-3 rounded-md font-medium hover:opacity-90 transition-opacity w-full sm:w-auto"
            >
              APPLY TO THIS JOB
            </button>
          </div>

          <!-- Summary Card -->
          <div class="bg-card border border-border rounded-lg p-6">
            <h2 class="text-lg font-bold mb-6">TÓM LƯỢC</h2>
            <table class="w-full table-auto text-sm text-foreground/90">
              <tr>
                <td class="border px-4 py-2">Bộ phận</td>
                <td class="border px-4 py-2">Xây dựng</td>
              </tr>
              <tr>
                <td class="border px-4 py-2">Chức danh</td>
                <td class="border px-4 py-2">Kỹ sư xây dựng</td>
              </tr>
              <tr>
                <td class="border px-4 py-2">Cán bộ quản lý trực tiếp</td>
                <td class="border px-4 py-2">Trưởng phòng/Trưởng bộ phận</td>
              </tr>
              <tr>
                <td class="border px-4 py-2">Địa điểm làm việc</td>
                <td class="border px-4 py-2"
                  >VPĐD: TT7A-9 KĐT Mới Đại Kim, Hoàng Mai, Hà Nội</td
                >
              </tr>
            </table>
          </div>

          <!-- Job Description -->
          <div class="bg-card border border-border rounded-lg p-6">
            <h2 class="text-lg font-bold mb-4">MÔ TẢ CÔNG VIỆC</h2>
            <ul
              class="text-sm list-disc list-inside text-foreground/90 leading-relaxed"
            >
              <li>
                Tiếp nhận yêu cầu khảo sát từ bộ phận kinh doanh, tiến hành đi
                khảo sát, trao đổi, tư vấn thiết kế trực tiếp với khách hàng.
              </li>
              <li>
                Trực tiếp tính toán, áp dụng kiến thức về xây dựng để thiết kế
                các hạng mục xây dựng (xây mới, cải tạo nhà xưởng hoặc công
                trình dân dụng) theo yêu cầu của khách hàng.
              </li>
              <li>
                Tuân theo các tiêu chuẩn của công ty, đảm bảo đáp ứng tất cả yêu
                cầu về thiết kế và thủ tục pháp lý.
              </li>
              <li>Bóc tách khối lượng, làm dự toán cho đơn hàng.</li>
              <li>
                Lập bản vẽ báo giá, làm việc với chủ đầu tư để chốt phương án
                thiết kế.
              </li>
              <li>Các công việc khác theo yêu cầu của quản lý trực tiếp.</li>
            </ul>
          </div>

          <!-- Requirements -->
          <div class="bg-card border border-border rounded-lg p-6">
            <h2 class="text-lg font-bold mb-4">YÊU CẦU</h2>
            <ul
              class="text-sm list-disc list-inside text-foreground/90 leading-relaxed"
            >
              <li>
                Tốt nghiệp Đại học chính quy chuyên ngành Kỹ thuật xây dựng, Kỹ
                sư công trình dân dụng – công nghiệp
              </li>
              <li>
                Có từ 2 năm kinh nghiệm ở mảng thiết kế, lập dự toán công trình.
              </li>
              <li>
                Sử dụng tốt AutoCAD, MS Project, Excel, ưu tiên có kiến thức về
                dự toán và hồ sơ hoàn công
              </li>
              <li>Am hiểu tiêu chuẩn kỹ thuật của các loại vật tư, thiết bị</li>
              <li>
                Có khả năng làm việc độc lập và phối hợp nhóm, xử lý tình huống
                tại công trường
              </li>
              <li>
                Chấp nhận đi công trình tỉnh, làm việc linh hoạt theo điều động
                dự án
              </li>
            </ul>
          </div>

          <!-- Benefits -->
          <div class="bg-card border border-border rounded-lg p-6">
            <h2 class="text-lg font-bold mb-4">QUYỀN LỢI</h2>
            <ul
              class="text-sm list-disc list-inside text-foreground/90 leading-relaxed"
            >
              <li>Thu nhập: 15-20 triệu (thỏa thuận theo năng lực)</li>
              <li>Lương trả 2 lần/tháng, không nợ lương chậm lương</li>
              <li>Ngày làm 8 tiếng, ngoài giờ tính tăng ca</li>
              <li>
                Chế độ phụ cấp: ăn, ở, đi lại, bằng lái ô tô, máy tính, điện
                thoại, sim trong quá trình làm việc.
              </li>
              <li>Tham gia đầy đủ chế độ BHXH, BHYT, BHTN.</li>
              <li>
                Thưởng Lễ, Tết, lương tháng 13, sinh nhật, team building, du
                lịch nghỉ mát hàng năm.
              </li>
              <li>
                Được tham gia các khóa đào tạo, có cơ hội thăng tiến rõ ràng.
              </li>
              <li>Môi trường làm việc chuyên nghiệp, năng động.</li>
            </ul>
          </div>

          <!-- Application -->
          <div class="bg-card border border-border rounded-lg p-6">
            <h2 class="text-lg font-bold mb-4 uppercase">Thời gian làm việc</h2>
            <ul
              class="text-sm list-disc list-inside text-foreground/90 leading-relaxed"
            >
              <li>Thời gian làm việc: 8h - 17h15’ từ thứ Hai đến thứ Bảy</li>
              <li>Nghỉ Chủ nhật hàng tuần và 2 ngày bất kì/tháng.</li>
            </ul>
          </div>

          <!-- Contact -->
          <div class="bg-card border border-border rounded-lg p-6">
            <h2 class="text-lg font-bold mb-4 uppercase">
              Cách thức ứng tuyển
            </h2>
            <ul
              class="text-sm list-disc list-inside text-foreground/90 leading-relaxed"
            >
              <li>
                Ứng viên nộp hồ sơ qua email: <a
                  class="text-primary hover:underline"
                  href="mailto:hrbinhphat@gmail.com">hrbinhphat@gmail.com</a
                >
              </li>
              <li>
                Liên hệ <i>Phòng nhân sự</i>:
                <b>Ms Hạnh (zalo) - 0987 538 455</b>
              </li>
            </ul>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- Company Card -->
          <div class="bg-card border border-border rounded-lg p-6 space-y-4">
            <div
              class="relative w-full aspect-[4/3] rounded-lg overflow-hidden bg-muted"
            >
              <img
                src="https://xaydungbinhphat.com.vn/contents/banner/20240517163359-son-sua-canteen.jpg"
                alt="Company Award"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="space-y-2">
              <h3 class="font-bold text-lg text-balance">
                CÔNG TY TNHH XÂY DỰNG VÀ CƠ ĐIỆN BÌNH PHÁT
              </h3>
              <p class="text-sm text-muted-foreground leading-relaxed">
                TRỤ SỞ CHÍNH : TT7A-9 KĐT mới Đại Kim, P. Định Công, TP. Hà Nội
              </p>
            </div>
          </div>

          <!-- Related Jobs -->
          <div class="bg-card border border-border rounded-lg p-6">
            <h3 class="font-bold text-lg mb-4">Các công việc khác</h3>
            <div class="space-y-4">
              {
                relatedJobs.map((job) => (
                  <div class="pb-4 border-b border-border last:border-0 last:pb-0 space-y-2 cursor-pointer hover:opacity-70 transition-opacity">
                    <h4 class="font-semibold text-sm">{job.title}</h4>
                    <p class="text-xs text-muted-foreground">{job.location}</p>
                    <p class="text-xs text-muted-foreground">{job.type}</p>
                    <p class="text-xs text-muted-foreground">
                      {job.experience}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

    type: "Lương thỏa thuận",
    experience: "Kỹ sư",
  },
  {
    title: "Giám sát Shop Drawing",
    location: "Lương thỏa thuận",
    type: "Kỹ sư",
    experience: "Ưu tiên có kinh nghiệm",
  },
  {
    title: "Giám sát QS",
    location: "Hà Nội, Bắc Ninh, Hồ Chí Minh, Đà Nẵng, Long An",
    type: "Lương thỏa thuận",
    experience: "Kỹ sư",
  },
];

export function getStaticPaths() {
  const jobs = [
    {
      title: "Giám sát Xây dựng",
      slug: "giam-sat-xay-dung",
      employmentType: "TOÀN THỜI GIAN",
      salary: "Ký sự",
      location: "Hà Nội, Hồ Chí Minh, Đà Nẵng, Long An, ... Lương thỏa thuận",
      tags: ["Xây dựng"],
      imageUrl:
        "https://hris.newtecons.vn/api/api/Base/GetFile?filePath=Attachments/screenshot_1682644823_20230428082043388.png",
      isNew: true,
    },
    {
      title: "Thư ký Công trình",
      slug: "thu-ky-cong-trinh",
      employmentType: "TOÀN THỜI GIAN",
      salary: "Lương thỏa thuận",
      location: "Hà Nội",
      tags: ["Kinh tế", "Kinh tế Xây dựng", "Quản trị", "Hành chính"],
      imageUrl:
        "https://hris.newtecons.vn/api/api/Base/GetFile?filePath=Attachments/business-people-working-laptop-development_1262-18907_20231030105131596.jpg",
      isNew: true,
    },
    {
      title: "Kỹ sư Xây dựng Dân dụng",
      slug: "ky-su-xay-dung-dan-dung",
      employmentType: "TOÀN THỜI GIAN",
      salary: "15-25 triệu VNĐ",
      location: "Hồ Chí Minh, Bình Dương",
      tags: ["Xây dựng", "Kỹ thuật"],
      imageUrl:
        "https://hris.newtecons.vn/api/api/Base/GetFile?filePath=Attachments/screenshot_1682645209_20230428082803039.png",
      isNew: false,
    },
    {
      title: "Trưởng phòng Kỹ thuật",
      slug: "truong-phong-ky-thuat",
      employmentType: "TOÀN THỜI GIAN",
      salary: "Lương thỏa thuận",
      location: "Hà Nội, Hải Phòng",
      tags: ["Quản lý", "Xây dựng", "Kỹ thuật"],
      imageUrl:
        "https://hris.newtecons.vn/api/api/Base/GetFile?filePath=Attachments/imager_104534_20220509071857163.jpg",
      isNew: true,
    },
  ];
  return jobs.map((job) => ({ params: { id: job.slug } }));
}

const { id } = Astro.params;
---

<Layout title="Bình Phát - Chi tiết tuyển dụng" snap={false}>
  <Hero />

  <div class="min-h-screen bg-background">
    <div class="container mx-auto px-4 py-8 lg:py-12">
      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-8">
          <!-- Header -->
          <div class="space-y-4">
            <h1 class="text-4xl lg:text-5xl font-bold text-balance">
              Giám sát Xây dựng
            </h1>
            <div class="flex flex-wrap items-center gap-3">
              <span
                class="bg-primary text-primary-foreground px-4 py-1.5 text-sm font-medium rounded-md"
              >
                TOÀN THỜI GIAN
              </span>
              <div class="flex items-center gap-2 text-muted-foreground">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
                  ></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span class="text-sm"
                  >Hà Nội, Hồ Chí Minh, Đà Nẵng, Long An, ... Lương thỏa thuận</span
                >
              </div>
            </div>
            <button
              class="bg-primary text-primary-foreground px-6 py-3 rounded-md font-medium hover:opacity-90 transition-opacity w-full sm:w-auto"
            >
              APPLY TO THIS JOB
            </button>
          </div>

          <!-- Summary Card -->
          <div class="bg-card border border-border rounded-lg p-6">
            <h2 class="text-xl font-bold mb-6">TÓM LƯỢC</h2>
            <div class="grid sm:grid-cols-2 gap-6">
              <div class="flex items-start gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5 text-primary mt-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect width="20" height="14" x="2" y="7" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
                <div>
                  <p class="text-sm text-muted-foreground">Kỹ sư</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5 text-primary mt-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <div>
                  <p class="text-sm font-medium">Cấp bậc</p>
                  <p class="text-sm text-muted-foreground">
                    Không yêu cầu kinh nghiệm
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5 text-primary mt-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <div>
                  <p class="text-sm font-medium">Kinh nghiệm</p>
                  <p class="text-sm text-muted-foreground">Nam</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5 text-primary mt-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <div>
                  <p class="text-sm font-medium">Giới tính</p>
                  <p class="text-sm text-muted-foreground">Xây dựng</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5 text-primary mt-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                  <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                </svg>
                <div>
                  <p class="text-sm font-medium">Ngành</p>
                  <p class="text-sm text-muted-foreground">Đại học</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5 text-primary mt-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                  <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                </svg>
                <div>
                  <p class="text-sm text-muted-foreground">Bằng cấp</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Job Description -->
          <div class="bg-card border border-border rounded-lg p-6">
            <h2 class="text-xl font-bold mb-4">MÔ TẢ CÔNG VIỆC</h2>
            <ul class="space-y-3 text-foreground/90 leading-relaxed">
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span>Lên kế hoạch, tổ chức và tiến hành thi công dự án.</span>
              </li>
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span
                  >Liên hệ với Chủ đầu tư/Tư vấn và các đơn vị liên quan nhằm
                  tiến hành hiệu quả công tác thi công/cơ điện của dự án.</span
                >
              </li>
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span
                  >Giám sát và kiểm soát công việc theo hệ thống quản lý chất
                  lượng và xác định các rủi ro trong thi công.</span
                >
              </li>
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span
                  >Hướng dẫn Cai thầu, Đội thi công, Thầu phụ tiến hành công
                  việc theo các yêu cầu đúng kỹ thuật và bản vẽ.</span
                >
              </li>
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span
                  >Phụ trách triển khai thi công, quản lý thi công và giám sát
                  thi công hạng mục/khu vực được giao theo hướng dẫn của Trưởng
                  nhóm TCTC.</span
                >
              </li>
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span
                  >Đảm bảo khu vực/hạng mục phụ trách thi công theo đúng bản vẽ
                  thiết kế, các quy chuẩn, tiêu chuẩn.</span
                >
              </li>
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span
                  >Kiểm soát đảm bảo an toàn và chất lượng an toàn công trình,
                  tuân thủ các thủ tục ISO của công ty.</span
                >
              </li>
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span>Thực hiện các yêu cầu của quản lý.</span>
              </li>
            </ul>
          </div>

          <!-- Requirements -->
          <div class="bg-card border border-border rounded-lg p-6">
            <h2 class="text-xl font-bold mb-4">YÊU CẦU CƠ BẢN</h2>
            <ul class="space-y-3 text-foreground/90 leading-relaxed">
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span
                  >Tốt nghiệp Đại học chính quy trở lên chuyên ngành Xây dựng
                  DD&CN, Kỹ thuật Xây dựng, Kinh tế Xây dựng...</span
                >
              </li>
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span>Kỹ năng quản lý và tổ chức tốt.</span>
              </li>
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span
                  >Sử dụng tốt phần mềm tin học chuyên ngành, tin học văn phòng.</span
                >
              </li>
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span
                  >Không ưu cầu kinh nghiệm, ưu tiên ứng viên làm việc ở khu vực
                  miền Bắc</span
                >
              </li>
            </ul>
          </div>

          <!-- Benefits -->
          <div class="bg-card border border-border rounded-lg p-6">
            <h2 class="text-xl font-bold mb-4">THU NHẬP VÀ PHÚC LỢI</h2>
            <ul class="space-y-3 text-foreground/90 leading-relaxed">
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span>Thu nhập: Thỏa thuận trong quá trình phỏng vấn.</span>
              </li>
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span
                  >Thử việc 100% lương, đóng BHXH full lương khi ký HĐLĐ chính
                  thức</span
                >
              </li>
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span>Có nhà ở BCH, phụ cấp cơm, điện thoại và đi lại</span>
              </li>
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span
                  >Môi trường làm việc chuyên nghiệp tại Công ty Xây dựng uy tín
                  hàng đầu Việt Nam.</span
                >
              </li>
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span
                  >Review lương hàng năm, khám sức khỏe tổng quát định kỳ mỗi
                  năm</span
                >
              </li>
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span
                  >Các chế độ khác: Đào tạo, teambuilding, bảo hiểm sức khỏe Bảo
                  Việt.</span
                >
              </li>
            </ul>
          </div>

          <!-- Application -->
          <div class="bg-card border border-border rounded-lg p-6">
            <h2 class="text-xl font-bold mb-4">HỒ SƠ ỨNG TUYỂN</h2>
            <ul class="space-y-3 text-foreground/90 leading-relaxed">
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span
                  >Mẫu Thông tin ứng viên (nhấn vào nút "Apply to this job" để
                  "Tải mẫu")</span
                >
              </li>
              <li class="flex gap-3">
                <span class="text-primary mt-1">•</span>
                <span>Bản photo bằng cấp chứng chỉ.</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- Company Card -->
          <div class="bg-card border border-border rounded-lg p-6 space-y-4">
            <div
              class="relative w-full aspect-[4/3] rounded-lg overflow-hidden bg-muted"
            >
              <img
                src="https://xaydungbinhphat.com.vn/contents/banner/20240517163359-son-sua-canteen.jpg"
                alt="Company Award"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="space-y-2">
              <h3 class="font-bold text-lg text-balance">
                CÔNG TY TNHH XÂY DỰNG VÀ CƠ ĐIỆN BÌNH PHÁT
              </h3>
              <p class="text-sm text-muted-foreground leading-relaxed">
                TRỤ SỞ CHÍNH : TT7A-9 KĐT mới Đại Kim, P. Định Công, TP. Hà Nội
              </p>
            </div>
          </div>

          <!-- Related Jobs -->
          <div class="bg-card border border-border rounded-lg p-6">
            <h3 class="font-bold text-lg mb-4">Các công việc khác</h3>
            <div class="space-y-4">
              {
                relatedJobs.map((job) => (
                  <div class="pb-4 border-b border-border last:border-0 last:pb-0 space-y-2 cursor-pointer hover:opacity-70 transition-opacity">
                    <h4 class="font-semibold text-sm">{job.title}</h4>
                    <p class="text-xs text-muted-foreground">{job.location}</p>
                    <p class="text-xs text-muted-foreground">{job.type}</p>
                    <p class="text-xs text-muted-foreground">
                      {job.experience}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

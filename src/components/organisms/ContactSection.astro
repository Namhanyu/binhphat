---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import bgImage from "../../assets/images/contact.webp";
import ContactForm from "./ContactForm";
import IconLocation from "../atoms/IconLocation.astro";
import IconZalo from "../atoms/IconZalo.astro";
import IconFacebook from "../atoms/IconFacebook.astro";
import IconYoutube from "../atoms/IconYoutube.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="contact"
  class="flex items-center md:min-h-screen bg-cover bg-bottom pb-4 pt-header"
  data-menu-color="primary"
  style={`background-image: url(${bgImage.src});`}
>
  <div class="container mx-auto">
    <div class="max-w-[600px] 3xl:max-w-[37.5vw]">
      <h2
        class="text-5xl max-md:text-3xl uppercase font-extrabold text-primary mb-4 3xl:mb-[1vw]"
        data-animate
        data-y="50"
      >
        {t("contact.title")}
      </h2>

      <!-- Company Information -->
      <div class="text-left space-y-3 3xl:space-y-[0.75vw]">
        <div data-animate data-x="-50">
          <h3
            class="flex items-center gap-[0.5em] uppercase font-bold text-primary"
          >
            <IconLocation class="w-[1em] h-auto flex-shrink-0" />
            {t("contact.headquarters")}
          </h3>
          <div>{t("contact.headquarters.address")}</div>
        </div>

        <div data-animate data-x="-50">
          <h3
            class="flex items-center gap-[0.5em] uppercase font-bold text-primary"
          >
            <IconLocation class="w-[1em] h-auto flex-shrink-0" />
            {t("contact.offices_hn")}
          </h3>
          <div class="space-y-1 3xl:space-y-[0.25vw]">
            {t("contact.offices.hanoi")}
          </div>
        </div>

        <div data-animate data-x="-50">
          <h3
            class="flex items-center gap-[0.5em] uppercase font-bold text-primary"
          >
            <IconLocation class="w-[1em] h-auto flex-shrink-0" />
            {t("contact.offices_hcm")}
          </h3>
          <div class="space-y-1 3xl:space-y-[0.25vw]">
            {t("contact.offices.hcm")}
          </div>
        </div>

        <div
          data-animate
          data-x="-50"
          class="whitespace-pre-line flex items-center justify-between"
        >
          <span>
            {t("contact.phone.email")}
          </span>
          <div class="flex items-center gap-[1em] text-primary">
            <a href="#" target="_blank" class="shrink-0">
              <IconZalo class="w-[2.5em] h-auto" />
            </a>
            <a href="#" target="_blank" class="shrink-0">
              <IconFacebook class="w-[2.5em] h-auto" />
            </a>
            <a href="#" target="_blank" class="shrink-0">
              <IconYoutube class="w-[2.5em] h-auto" />
            </a>
          </div>
        </div>

        <div data-animate data-x="-50">
          <ContactForm client:idle client:only />
        </div>
      </div>
    </div>
  </div>
</section>

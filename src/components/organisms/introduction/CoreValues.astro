---
import bgImage from "../../../assets/images/11.webp";
import image1 from "../../../assets/images/34.webp";
import circle from "../../../assets/images/35.webp";
import icon1 from "../../../assets/images/29.webp";
import icon2 from "../../../assets/images/30.webp";
import icon3 from "../../../assets/images/31.webp";
import icon4 from "../../../assets/images/32.webp";
import icon5 from "../../../assets/images/33.webp";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="core_values"
  data-menu-color="white"
  class="bg-cover bg-center"
  style={`background-image: url(${bgImage.src});`}
>
  <div
    class="md:h-screen container flex flex-col justify-end pt-header overflow-hidden"
  >
    <div
      class="text-center space-y-2 text-white max-md:mb-10 3xl:space-y-[0.5vw] z-20 relative max-md:mt-24"
    >
      <h2
        class="text-5xl font-extrabold uppercase max-md:text-3xl"
        data-animate
        data-y="50"
      >
        {t("core_values.title")}
      </h2>
      <div class="text-3xl max-md:text-xl uppercase" data-animate data-x="-50">
        {t("core_values.subtitle")}
      </div>
    </div>

    <div data-animate data-y="30" class="text-center md:hidden text-white mb-4">
      {t("core_values.description")}
    </div>

    <svg
      viewBox="0 0 1300 698"
      class="h-auto w-full mx-auto text-white"
      preserveAspectRatio="xMidYMax meet"
    >
      <image href={image1.src} height="698" width="1300" />

      <g data-animate data-x="-30">
        <image x="130" y="420" href={circle.src} height="120" width="120" />
        <image x="160" y="450" href={icon1.src} height="60" />
        <text
          x="190"
          y="575"
          font-size="24px"
          text-anchor="middle"
          fill="white"
          class="font-bold uppercase"
        >
          {t("core_values.1")}
        </text>
      </g>

      <g data-animate data-x="-30" data-y="-30">
        <image x="292" y="197" href={circle.src} height="120" width="120" />
        <image
          x="292"
          y="227"
          href={icon2.src}
          height="60"
          width="120"
          preserveAspectRatio="xMidYMid meet"
        />
        <text
          x="352"
          y="352"
          font-size="24px"
          text-anchor="middle"
          fill="white"
          class="font-bold uppercase"
        >
          {t("core_values.2")}
        </text>
      </g>

      <g data-animate data-y="-30">
        <image x="590" y="100" href={circle.src} height="120" width="120" />
        <image
          x="590"
          y="130"
          href={icon3.src}
          height="60"
          width="120"
          preserveAspectRatio="xMidYMid meet"
        />
        <text
          x="650"
          y="256"
          font-size="24px"
          text-anchor="middle"
          fill="white"
          class="font-bold uppercase"
        >
          {t("core_values.3")}
        </text>
      </g>

      <g data-animate data-x="30" data-y="-30">
        <image x="888" y="197" href={circle.src} height="120" width="120" />
        <image
          x="888"
          y="227"
          href={icon4.src}
          height="60"
          width="120"
          preserveAspectRatio="xMidYMid meet"
        />
        <text
          x="948"
          y="352"
          font-size="24px"
          text-anchor="middle"
          fill="white"
          class="font-bold uppercase"
        >
          {t("core_values.4")}
        </text>
      </g>

      <g data-animate data-x="30">
        <image x="1050" y="420" href={circle.src} height="120" width="120" />
        <image x="1080" y="450" href={icon5.src} height="60" />
        <text
          x="1110"
          y="575"
          font-size="24px"
          text-anchor="middle"
          fill="white"
          class="font-bold uppercase"
        >
          {t("core_values.5")}
        </text>
      </g>

      <foreignObject
        x="350"
        y="470"
        width="600"
        height="200"
        data-animate
        data-y="30"
        class="max-md:hidden"
      >
        <div class="text-center">{t("core_values.description")}</div>
      </foreignObject>
    </svg>
  </div>
</section>

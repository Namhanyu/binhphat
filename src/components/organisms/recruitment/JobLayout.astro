---
import Layout from "../../../layouts/Layout.astro";
import Hero from "./Hero.astro";
import { relatedJobs } from "./related";

const { title = "Bình Phát" } = Astro.props;
---

<Layout
  title={`Bình Phát - Tuyển dụng - ${title}`}
  snap={false}
>
  <Hero />

  <div class="min-h-screen bg-background">
    <div class="container mx-auto px-4 py-8 lg:py-12">
      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-8">
          <!-- Header -->
          <h1 class="text-4xl lg:text-5xl font-bold text-balance">
            {title}
          </h1>

          <div class="space-y-8">
            <slot />
          </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- Company Card -->
          <div class="bg-card border border-border rounded-lg p-6 space-y-4">
            <div
              class="relative w-full aspect-[4/3] rounded-lg overflow-hidden bg-muted"
            >
              <img
                src="https://xaydungbinhphat.com.vn/contents/banner/20240517163359-son-sua-canteen.jpg"
                alt="Company Award"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="space-y-2">
              <h3 class="font-bold text-lg text-balance">
                CÔNG TY TNHH XÂY DỰNG VÀ CƠ ĐIỆN BÌNH PHÁT
              </h3>
              <p class="text-sm text-muted-foreground leading-relaxed">
                TRỤ SỞ CHÍNH : TT7A-9 KĐT mới Đại Kim, P. Định Công, TP. Hà Nội
              </p>
            </div>
          </div>

          <!-- Related Jobs -->
          <div class="bg-card border border-border rounded-lg p-6">
            <h3 class="font-bold text-lg mb-4">Các công việc khác</h3>
            <div class="space-y-4">
              {
                relatedJobs.map((job) => (
                  <div class="pb-4 border-b border-border last:border-0 last:pb-0 space-y-2 hover:opacity-70 transition-opacity">
                    <a
                      class="font-semibold text-sm"
                      href={`/tuyen-dung/${job.slug}`}
                    >
                      {job.title}
                    </a>
                    <p class="text-xs text-muted-foreground">{job.location}</p>
                    <p class="text-xs text-muted-foreground">{job.salary}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

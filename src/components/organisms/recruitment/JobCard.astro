---
const {
  title,
  employmentType,
  salary,
  location,
  tags = [],
  imageUrl,
  isNew = false,
} = Astro.props;
---

<div
  class="relative bg-card rounded-lg border border-border overflow-hidden hover:shadow-lg transition-shadow"
>
  {
    isNew && (
      <div class="absolute top-4 right-4 z-10">
        <span class="inline-flex items-center rounded-md bg-[#48d1a9] text-white font-semibold px-3 py-1 text-sm">
          MỚI
        </span>
      </div>
    )
  }

  <div class="flex flex-col md:flex-row gap-6 p-6">
    <!-- Image Section -->
    <div class="flex-shrink-0">
      <div
        class="relative w-full md:w-[200px] h-[160px] bg-muted rounded-lg overflow-hidden"
      >
        <img
          src={imageUrl || "/placeholder.svg"}
          alt={title}
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    <!-- Content Section -->
    <div class="flex-1 flex flex-col gap-3">
      <!-- Title and Employment Type -->
      <div class="flex flex-wrap items-center gap-3">
        <h3
          class="text-xl font-bold text-foreground hover:text-primary cursor-pointer transition-colors"
        >
          {title}
        </h3>
        <span
          class="inline-flex items-center rounded-md border border-primary text-primary font-medium px-3 py-1 text-sm"
        >
          {employmentType}
        </span>
      </div>

      <!-- Salary -->
      <div class="text-base text-muted-foreground font-medium">{salary}</div>

      <!-- Location -->
      <div class="text-base text-muted-foreground">{location}</div>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mt-auto">
        {
          tags.map((tag) => (
            <span class="inline-flex items-center rounded-md bg-[#e1ecf4] hover:bg-accent/80 cursor-pointer px-3 py-1 text-sm text-[#376d95]">
              {tag}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</div>

---
import bgImage from "../../../assets/images/equipment-01.webp";
import fgImage from "../../../assets/images/equipment-02.webp";

import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="equipment"
  data-menu-color="primary"
  class="max-md:h-[600px] md:min-h-screen bg-cover bg-bottom bg-no-repeat flex items-center justify-center py-20 relative"
  style={`background-image: url(${bgImage.src});`}
>
  <img
    src={fgImage.src}
    class="absolute bottom-0 left-0 w-full right-0 h-auto"
    data-animate
    data-y="100"
  />

  <div class="px-[6vw] flex items-center w-full mb-[20vw]">
    <div
      class="grid gap-10 3xl:gap-[2.5vw] md:max-w-[560px] 3xl:max-w-[35vw] ml-auto"
    >
      <h2
        class="text-5xl font-extrabold uppercase max-md:text-3xl whitespace-pre-line text-primary text-right"
        data-animate
        data-y="-50"
      >
        {t("equipment.title")}
      </h2>
      <p
        class="text-lg max-md:text-base text-justify"
        data-animate
        data-x="-50"
      >
        {t("equipment.content")}
      </p>
    </div>
  </div>
</section>

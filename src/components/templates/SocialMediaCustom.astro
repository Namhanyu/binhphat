---
import SocialMediaFloat from "../organisms/SocialMediaFloat.astro";

// Props cho component này có thể override config mặc định
const {
  position = "bottom-right",
  zaloLink,
  facebookLink,
  showOnlyZalo = false,
  showOnlyFacebook = false,
} = Astro.props;

// Logic để hiển thị buttons cụ thể
let customConfig = {};

if (showOnlyZalo) {
  customConfig = {
    zalo: { enabled: true },
    facebook: { enabled: false },
  };
} else if (showOnlyFacebook) {
  customConfig = {
    zalo: { enabled: false },
    facebook: { enabled: true },
  };
}
---

<!-- Sử dụng component chính với custom props -->
<SocialMediaFloat
  position={position}
  zaloLink={zaloLink}
  facebookLink={facebookLink}
/>
